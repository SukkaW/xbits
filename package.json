{
  "name": "xbits",
  "version": "0.2.1-beta.1",
  "description": "Convert bits and bytes to a human readable string",
  "homepage": "https://github.com/SukkaW/xbits#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SukkaW/xbits.git"
  },
  "bugs": {
    "url": "https://github.com/SukkaW/xbits/issues"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.mjs",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.mts",
        "default": "./dist/es/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint --format=sukka .",
    "build": "bunchee -m",
    "test": "nyc mocha --require @swc-node/register test/**/*.ts",
    "prerelease": "pnpm run lint && pnpm run build && pnpm run test",
    "release": "bumpp -r --all --commit \"release: %s\" --tag \"%s\""
  },
  "keywords": [],
  "author": "Sukka <https://skk.moe>",
  "license": "MIT",
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/mocha": "^10.0.10",
    "bumpp": "^10.4.1",
    "bunchee": "^6.12.2",
    "earl": "^2.0.0",
    "eslint": "^10.8.1",
    "eslint-config-sukka": "^9.0.0",
    "eslint-formatter-sukka": "^9.0.0",
    "mocha": "^11.8.0",
    "nyc": "^18.0.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.20.0"
}
